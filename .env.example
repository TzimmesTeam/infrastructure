# Registry references and local stack settings.
COMPOSE_PROJECT_NAME=zimmes
BIND_ADDRESS=127.0.0.1

ZIMMES_IMAGE_NAMESPACE=ghcr.io/tzimmesteam
ZIMMES_IMAGE_TAG=latest
# Override complete references when packages use different tags or registries.
# CONTROL_PLANE_IMAGE=ghcr.io/tzimmesteam/control-plane:latest
# DATA_PREP_IMAGE=ghcr.io/tzimmesteam/data-prep:latest
# EVENT_BRIDGE_IMAGE=ghcr.io/tzimmesteam/event-bridge:latest

POSTGRES_IMAGE=docker.io/library/postgres:18.7-alpine
POSTGRES_DB=control_plane
POSTGRES_USER=zimmes
POSTGRES_PASSWORD=zimmes-local-postgres
POSTGRES_PORT=5432
# Supply a complete, URL-encoded DSN if the user/password/database has special characters.
# DB_DSN=postgres://zimmes:zimmes-local-postgres@postgres:5432/control_plane?sslmode=disable

NATS_IMAGE=docker.io/library/nats:2.15.3-alpine
NATS_PORT=4222
NATS_MONITOR_PORT=8222

S3_IMAGE=docker.io/chrislusf/seaweedfs:4.54
S3_PORT=9000
S3_ADMIN_PORT=12535
# Generate independent passwords to enable the local SeaweedFS web console.
# S3_ADMIN_PASSWORD=
# S3_VIEWER_PASSWORD=
ICEBERG_PORT=8181
S3_TABLE_BUCKET=warehouse
AWS_CLI_IMAGE=docker.io/amazon/aws-cli:2.40.4
LOCALSTACK_IMAGE=docker.io/localstack/localstack:3.8
S3_ACCESS_KEY=zimmes-local
S3_SECRET_KEY=zimmes-local-s3-secret
S3_REGION=us-east-1
S3_RAW_BUCKET=irrbb-raw-local
S3_CURATED_BUCKET=irrbb-curated-local
S3_QUARANTINE_BUCKET=irrbb-quarantine-local
S3_ARTIFACTS_BUCKET=irrbb-artifacts-local
S3_SCRATCH_BUCKET=irrbb-scratch-local

CONTROL_PLANE_PORT=8089
DATA_PREP_PORT=8080
RUN_BATCH_SIZE=10000
RUN_DEFAULT_REPORT_DTTM=1970-01-01
# RUN_DEFAULT_CURVES_URI=s3://irrbb-curated-local/curve_snapshots/default/curves.parquet

# Set these only when compatible external images are available.
# CASHFLOW_WORKER_IMAGE=
# PV_WORKER_IMAGE=
# AGGREGATOR_IMAGE=
